<?xml version="1.0" encoding="utf-8"?>
<!-- Sauvegarde automatique Android (Android 12+) : sauvegarde cloud et transfert vers un nouvel appareil. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="shelves.db" />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="shelves.db" />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
